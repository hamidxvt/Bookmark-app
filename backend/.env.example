# Copy this to .env and fill in values

# Railway PostgreSQL — use the same DATABASE_URL as your admin dashboard
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# JWT Secret — must match admin's NEXTAUTH_SECRET or set separately
JWT_SECRET="your-super-secret-32-char-key-here"

# Server
NODE_ENV="production"
PORT=3001

# CORS — admin dashboard URL
ALLOWED_ORIGINS="https://bookmark-production-00c6.up.railway.app"
