<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:tag="layout/activity_profile_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/cross_btn"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:fontFamily="@font/outfit_bold"/>
                <TextView
                    android:textSize="14sp"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Id"
                    android:fontFamily="@font/outfit"/>
                <com.google.android.material.chip.Chip
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:tag="binding_3"
                    android:padding="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Settings"
                    android:fontFamily="@font/outfit_medium"
                    app:chipIcon="@drawable/ic_settings"
                    app:chipIconVisible="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <io.github.florent37.shapeofview.shapes.CircleView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/imgCircleProfile"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    app:shape_circle_borderColor="@color/black"
                    app:shape_circle_borderWidth="@dimen/_2sdp">
                    <ImageView
                        android:padding="@dimen/_20sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/photo"
                        android:contentDescription="@string/no"
                        app:tint="@color/black"/>
                    <ImageView
                        android:id="@+id/imgProfile"
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/no"/>
                </io.github.florent37.shapeofview.shapes.CircleView>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Details"
                android:layout_weight="2"
                android:fontFamily="@font/outfit_semibold"/>
            <com.google.android.material.chip.Chip
                android:textSize="12sp"
                android:id="@+id/requestToEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request to Edit"
                android:layout_marginEnd="5dp"
                app:chipIcon="@drawable/ic_request_to_edit"
                app:chipIconSize="@dimen/_12sdp"
                app:chipIconVisible="true"
                app:chipStartPadding="10dp"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:cardCornerRadius="15dp"
            app:cardElevation="@dimen/_1sdp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_12sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:fontFamily="@font/outfit"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/city_bg"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:gravity="center_vertical"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Karachi"
                        android:singleLine="true"
                        android:fontFamily="@font/outfit_medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:tag="binding_6"
                        android:background="@drawable/profile_defualt_karachi"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Default"
                        android:singleLine="true"
                        android:fontFamily="@font/outfit_medium"
                        android:paddingStart="12dp"
                        android:paddingEnd="5dp"
                        android:layout_marginStart="5dp"/>
                    <ImageView
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/profile_menu"
                        android:fontFamily="@font/outfit_semibold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="150dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Location"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="address"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Email"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="email"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Phone"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="phone"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Member Since"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="date"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Role"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="role"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Number Of Invoices"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="number of invoices"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Outstanding Balance"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:tag="binding_13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="balance"
                    android:fontFamily="@font/outfit"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:tag="binding_14"
            android:background="@drawable/tag_bg"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/_20sdp"
            android:backgroundTint="@color/tag_color3">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_signout"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/app_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign out"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginStart="@dimen/_8sdp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2">
            <TextView
                android:textSize="12sp"
                android:gravity="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/report_issue"
                android:layout_weight="1"
                android:fontFamily="@font/outfit"
                android:paddingEnd="15dp"/>
            <TextView
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/privacy_terms"
                android:layout_weight="1"
                android:fontFamily="@font/outfit"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
