<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_low_stock_products_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_5sdp">
        <FrameLayout
            android:background="@drawable/low_stock_item_bg"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_5sdp">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:tag="binding_1"
                android:layout_width="40dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_segment_book_img"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornersImage"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Pearls of English"
                android:fontFamily="@font/outfit_medium"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/app_color"
                android:textColorHint="@color/app_color"
                android:id="@+id/product_price"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="PKR.370.00"
                android:fontFamily="@font/outfit_bold"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:background="@drawable/edittext_background"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:backgroundTint="@color/grey">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/subtract_iv"
            android:layout_width="14dp"
            android:layout_height="9dp"
            android:src="@drawable/ic_minus_visit_products"/>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/productQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="50"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_semibold"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/add_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/first_quantity"
            android:background="@drawable/edittext_background"
            android:padding="@dimen/_8sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="50 Books"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"
            android:layout_marginEnd="@dimen/_5sdp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/second_quantity"
            android:background="@drawable/edittext_background"
            android:padding="@dimen/_8sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="100 Books"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"
            android:layout_marginEnd="@dimen/_5sdp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/third_quantity"
            android:background="@drawable/edittext_background"
            android:padding="@dimen/_8sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="200 Books"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"/>
    </LinearLayout>
</LinearLayout>
