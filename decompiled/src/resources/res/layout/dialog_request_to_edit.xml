<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_request_to_edit_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/_2sdp"
    app:cardCornerRadius="25dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Request to Edit"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_bold"/>
            <ImageView
                android:id="@+id/start_job_cross_iv"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/cross_btn"
                android:contentDescription="close"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Your profile details are managed by head office. Submit a request to update your information, and we’ll review it within 24–48 hours."
            android:fontFamily="@font/outfit_medium"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/cancel_btn"
                android:background="@drawable/btn_style"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Cancel"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginEnd="@dimen/_5sdp"/>
            <Button
                android:textSize="16sp"
                android:id="@+id/start_job_btn"
                android:background="@drawable/edittext_background"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Send Request"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_medium"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.cardview.widget.CardView>
