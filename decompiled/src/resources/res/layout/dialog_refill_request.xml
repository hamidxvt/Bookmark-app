<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_refill_request_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_5sdp"
    android:layout_marginStart="@dimen/_16sdp"
    android:layout_marginEnd="@dimen/_16sdp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_12sdp"
        app:cardCornerRadius="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_refill_request_img"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/close_btn"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:src="@drawable/cross_btn"
            android:scaleType="centerCrop"
            android:layout_marginEnd="@dimen/_12sdp"
            app:tint="@color/white"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:src="@drawable/ic_refill_request"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="8dp"
                android:text="Re-Fill Request Added!"
                android:fontFamily="@font/outfit_bold"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/description_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12sdp"
                android:text="@string/we_ve_received_your_refill_request_you_can_n_track_it_anytime"
                android:fontFamily="@font/outfit_medium"
                app:layout_constraintTop_toBottomOf="@+id/title_text"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_16sdp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_10sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:layout_gravity="center"
                        android:id="@+id/track_id_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:text="Track ID"
                        android:fontFamily="@font/outfit"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/track_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="ID"
                        android:fontFamily="@font/outfit"/>
                </LinearLayout>
                <View
                    android:background="@color/white"
                    android:layout_width="@dimen/_2sdp"
                    android:layout_height="@dimen/_45sdp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_10sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:layout_gravity="center"
                        android:id="@+id/datetrack_id_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:fontFamily="@font/outfit"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Date"
                        android:maxLength="10"
                        android:fontFamily="@font/outfit"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/view_requests_button"
                android:background="@drawable/edittext_background"
                android:padding="@dimen/_12sdp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="View Requests"
                android:fontFamily="@font/outfit_medium"
                android:backgroundTint="@color/white"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
