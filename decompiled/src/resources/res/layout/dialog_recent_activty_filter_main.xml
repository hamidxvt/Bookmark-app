<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_recent_activty_filter_main_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/_2sdp"
    app:cardCornerRadius="@dimen/_30sdp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tvFilterTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Filter"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_bold"/>
            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/cross_btn"
                app:tint="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnActionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Activity Type"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/main_filter_arrow_right"
                app:tint="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnDateRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Data Range"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/main_filter_arrow_right"
                app:tint="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="By Area"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/main_filter_arrow_right"
                app:tint="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@android:color/black"
                android:id="@+id/btnClearAll"
                android:background="@drawable/btn_style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Clear all"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:backgroundTint="@color/grey_light"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/btnDone"
                android:background="@drawable/edittext_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Done"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
