<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_customer_0"
    android:paddingTop="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Customers"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"/>
        <ImageView
            android:id="@+id/performanceMenu"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_three_dots"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_font"
                    android:id="@+id/inventory_search_et"
                    android:background="@drawable/edittext_background"
                    android:padding="@dimen/_8sdp"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="5dp"
                    android:hint="Search by segment, grade"
                    android:singleLine="true"
                    android:drawablePadding="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_search_visit"
                    android:fontFamily="@font/outfit"
                    android:elevation="1.5dp"
                    android:backgroundTint="@color/grey"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cancel_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:fontFamily="@font/outfit"
                    android:layout_marginStart="@dimen/_8sdp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <ImageView
                    android:tag="binding_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/filter_icon"
                    android:scaleType="centerCrop"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/customers_list_filter_rv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="15dp"
                app:cardElevation="@dimen/_1sdp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="@dimen/_12sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_low_stock"
                        android:scaleType="centerCrop"
                        android:contentDescription="oustanding samples"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sample Outstanding"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/books_samples_given_to_the_customer"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_right_customer"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_total_summary_img"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customers"
                            android:fontFamily="@font/outfit_light"/>
                        <TextView
                            android:textSize="24dp"
                            android:textColor="@color/white"
                            android:tag="binding_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="157"
                            android:fontFamily="@font/outfit_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/grey_light"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Schools"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"
                            android:layout_gravity="center"
                            android:tag="binding_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="34"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                    <View
                        android:background="@color/grey_light"
                        android:layout_width="@dimen/_3sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_5sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/grey_light"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookshops"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"
                            android:layout_gravity="center"
                            android:tag="binding_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="34"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/grey"
                app:cardCornerRadius="30dp"
                app:cardElevation="1dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@drawable/custom_button_background"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/all_type_layout"
                            android:background="@drawable/selected_button_background"
                            android:padding="@dimen/_5sdp"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_5sdp">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/app_color"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/customer_type_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All"
                                android:drawablePadding="@dimen/_5sdp"
                                android:drawableStart="@drawable/ic_all"
                                android:fontFamily="@font/outfit"
                                android:drawableTint="@color/app_color"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/school_type_layout"
                            android:background="@drawable/unselected_button_background"
                            android:padding="@dimen/_5sdp"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_5sdp">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/grey_font"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/customer_type_school"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Schools"
                                android:drawablePadding="@dimen/_5sdp"
                                android:drawableStart="@drawable/school_icon"
                                android:fontFamily="@font/outfit"
                                android:drawableTint="@color/grey_font"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/shop_type_layout"
                            android:background="@drawable/unselected_button_background"
                            android:padding="@dimen/_5sdp"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="14sp"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/customer_type_bookshop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bookshops"
                                android:maxLines="1"
                                android:drawablePadding="@dimen/_5sdp"
                                android:drawableStart="@drawable/shop_icon"
                                android:fontFamily="@font/outfit"
                                android:drawableTint="@color/grey_font"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="All Customers"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit_bold"/>
                <ImageView
                    android:id="@+id/filter_icon_iv"
                    android:tag="binding_5"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/filter_icon"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/customerListRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
