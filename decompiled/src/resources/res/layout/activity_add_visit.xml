<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:tag="layout/activity_add_visit_0"
    android:background="@drawable/dialog_top_round"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        layout="@layout/layout_header"/>
    <include
        android:id="@+id/layoutProgressIndicator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layoutHeader"
        layout="@layout/layout_loading"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_5sdp"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_8sdp"
                android:text="Customer Type"
                android:fontFamily="@font/outfit_medium"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="30dp"
                app:cardElevation="0.1dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/custom_button_background"
                    android:padding="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/school_type_layout"
                        android:background="@drawable/selected_button_background"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:elevation="0.3dp"
                        android:backgroundTint="#ffffff">
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textColor="@color/app_color"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/customer_type_school"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Schools"
                            android:drawablePadding="@dimen/_5sdp"
                            android:drawableStart="@drawable/school_icon"
                            android:fontFamily="@font/outfit"
                            android:drawableTint="@color/app_color"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/shop_type_layout"
                        android:background="@drawable/unselected_button_background"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:elevation="0.3dp"
                        android:backgroundTint="#ffffff">
                        <TextView
                            android:textSize="14sp"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/customer_type_bookshop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookshops"
                            android:drawablePadding="@dimen/_5sdp"
                            android:drawableStart="@drawable/shop_icon"
                            android:fontFamily="@font/outfit"
                            android:drawableTint="@color/grey_font"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/customer_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="School Name"
                android:fontFamily="@font/outfit_medium"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_font"
                android:id="@+id/customer_name_et"
                android:background="@drawable/edittext_background"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:hint="Name of School"
                android:drawablePadding="@dimen/_5sdp"
                android:inputType="text"
                android:drawableStart="@drawable/ic_search_visit"
                android:fontFamily="@font/outfit"
                android:paddingStart="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Date"
                android:fontFamily="@font/outfit_medium"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_font"
                android:id="@+id/date_et"
                android:tag="binding_1"
                android:background="@drawable/edittext_background"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:hint="Choose date"
                android:inputType="none"
                android:drawableEnd="@drawable/ic_date"
                android:fontFamily="@font/outfit"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/location_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Visit Purpose"
                android:fontFamily="@font/outfit_medium"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_font"
                android:id="@+id/purpose_et"
                android:background="@drawable/edittext_background"
                android:padding="@dimen/_8sdp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:hint="Enter Purpose"
                android:fontFamily="@font/outfit"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="Priority"
                android:fontFamily="@font/outfit_medium"/>
            <LinearLayout
                android:id="@+id/linear_priority"
                android:background="@drawable/edittext_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="@dimen/_5sdp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/priority_low"
                    android:background="@drawable/low"
                    android:padding="@dimen/_12sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:gravity="center"
                    android:id="@+id/priority_medium"
                    android:background="@drawable/medium_white"
                    android:padding="@dimen/_12sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:gravity="center"
                    android:id="@+id/priority_high"
                    android:background="@drawable/hight_white"
                    android:padding="@dimen/_12sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/customerListRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="16sp"
                android:layout_gravity="center"
                android:id="@+id/btnAddCustomer"
                android:tag="binding_2"
                android:background="@drawable/button_shape"
                android:layout_width="343dp"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="10dp"
                android:text="Add Visit"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_medium"
                app:backgroundTint="@color/app_color"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
