<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_all_products_cart_0"
    android:layout_width="match_parent"
    android:layout_height="163dp"
    android:layout_margin="5dp">
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/delete_product_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_6sdp"
            android:elevation="@dimen/_2sdp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    app:cardBackgroundColor="@color/grey"
                    app:cardCornerRadius="10dp"
                    app:strokeWidth="0.1dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_gravity="center"
                        android:id="@+id/product_image"
                        android:layout_width="40dp"
                        android:layout_height="54dp"
                        android:src="@drawable/photo"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/RoundedCornersImage"/>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/black"
                        android:id="@+id/product_name"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:id="@+id/grade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_medium"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/subject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_medium"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/red"
                        android:id="@+id/product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/edittext_background"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:backgroundTint="@color/grey">
                <ImageView
                    android:id="@+id/btn_minus"
                    android:paddingBottom="10dp"
                    android:layout_width="50dp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_minus"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_quantity"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"/>
                <ImageView
                    android:id="@+id/btn_plus"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="50dp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_plus"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/delete_product_iv"
        android:visibility="gone"
        android:layout_width="105dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/red"
            android:gravity="center"
            android:background="@drawable/all_product_delete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Delete"
            android:fontFamily="@font/outfit_medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
