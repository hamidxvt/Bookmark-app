<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_added_by_filter_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/_2sdp"
    app:cardCornerRadius="25dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Added By"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_semibold"/>
            <ImageView
                android:id="@+id/added_by_cross_iv"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/cross_btn"
                android:contentDescription="close"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/added_by_all"
                android:background="@drawable/priority_selector"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:text="All"
                android:singleLine="true"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginEnd="@dimen/_8sdp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/added_by_admin"
                android:background="@drawable/priority_selector"
                android:layout_width="70dp"
                android:layout_height="40dp"
                android:text="Admin"
                android:singleLine="true"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginEnd="@dimen/_8sdp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/added_by_user"
                android:background="@drawable/priority_selector"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="User (Me)"
                android:singleLine="true"
                android:fontFamily="@font/outfit_medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/addedBy_cancel_btn"
                android:background="@drawable/btn_style"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Clear All"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginEnd="@dimen/_5sdp"/>
            <Button
                android:textSize="16sp"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/addedBy_done_btn"
                android:background="@drawable/edittext_background"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Done"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_medium"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
