<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fafafa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#fafafa">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo"
            android:scaleType="fitXY"
            android:contentDescription="Notification Icon"
            android:layout_marginEnd="5dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Notification Title"
                android:fontFamily="@font/outfit_semibold"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="This is a short notification message"
                android:fontFamily="@font/outfit"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/tvDate"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="2025-10-10 10:30 AM"
            android:singleLine="true"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="@color/alto"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"/>
</androidx.cardview.widget.CardView>
