<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/last_visit_layout"
    android:tag="layout/item_customers_selection_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:layout_marginTop="@dimen/_12sdp"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="@dimen/_2sdp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvCustomer"
                android:tag="binding_1"
                android:background="@drawable/tag_bg"
                android:padding="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="School"
                android:drawablePadding="5dp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:backgroundTint="@color/tag_color1"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:gravity="end"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="4 Days ago"
            android:fontFamily="@font/outfit"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/black"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:hint="School Name"
            android:fontFamily="@font/outfit_semibold"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:textColorHint="@color/gray"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:hint="North Nazimabad"
            android:fontFamily="@font/outfit"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
