<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_visit_details_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Customer Information"
                android:layout_weight="2"
                android:fontFamily="@font/outfit_semibold"/>
            <com.google.android.material.chip.Chip
                android:textSize="12sp"
                android:id="@+id/requestToEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Info"
                android:layout_marginEnd="5dp"
                app:chipIcon="@drawable/ic_request_to_edit"
                app:chipIconSize="14dp"
                app:chipIconVisible="true"
                app:chipStartPadding="10dp"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="1.5dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_8sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="No Address"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Key Contact"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="key contact"
                    android:fontFamily="@font/outfit"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="Visit Objectives"
            android:fontFamily="@font/outfit_semibold"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            app:cardCornerRadius="15dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_8sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="No description found"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Assigned By"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="key contact"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Special Instruction"
                    android:fontFamily="@font/outfit"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="No Special Instruction Found"
                    android:fontFamily="@font/outfit"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/visit_count_bg"
                android:padding="@dimen/_12sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#1904b45c">
                <ImageView
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:src="@drawable/ic_visited"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/green_text"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visits"
                        android:fontFamily="@font/outfit"/>
                    <TextView
                        android:textSize="@dimen/_16ssp"
                        android:textColor="@color/green_text"
                        android:textColorHint="@color/green_text"
                        android:gravity="end"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="23"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_bold"/>
                </LinearLayout>
            </LinearLayout>
            <Space
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/visit_count_bg"
                android:padding="@dimen/_12sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/tag_color3">
                <ImageView
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:src="@drawable/ic_visit_sample"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/app_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samples"
                        android:fontFamily="@font/outfit"/>
                    <TextView
                        android:textSize="@dimen/_16ssp"
                        android:textColor="@color/app_color"
                        android:textColorHint="@color/app_color"
                        android:gravity="end"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="23"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
