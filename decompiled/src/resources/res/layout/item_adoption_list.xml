<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_adoption_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="@dimen/_10sdp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="13.5dp"
            android:layout_width="match_parent"
            android:layout_height="127dp"
            android:layout_marginStart="15.5dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:tag="binding_1"
                android:background="@drawable/edittext_background_green"
                android:padding="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">
                <ImageView
                    android:tag="binding_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/ic_circle"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    app:tint="#26af22"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#26af22"
                    android:textColorHint="#26af22"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Approved"
                    android:fontFamily="@font/outfit"
                    android:layout_marginEnd="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:hint="Academic year 2024"
                android:fontFamily="@font/outfit_semibold"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#0687e3"
                    android:textColorHint="#0687e3"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:tag="binding_5"
                    android:background="@drawable/edittext_background"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:hint="12 Books"
                    android:singleLine="true"
                    android:fontFamily="@font/outfit"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:backgroundTint="@color/tag_color1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:tag="binding_6"
                    android:background="@drawable/edittext_background"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:hint="340 Quantity"
                    android:singleLine="true"
                    android:fontFamily="@font/outfit"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:backgroundTint="@color/grey_light"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
