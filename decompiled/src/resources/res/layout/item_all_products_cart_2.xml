<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_all_products_cart_2_0"
    android:padding="@dimen/_8sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:elevation="@dimen/_2sdp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/product_item_bg"
            android:layout_width="75dp"
            android:layout_height="75dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/product_image"
                android:layout_width="40dp"
                android:layout_height="54dp"
                android:src="@drawable/photo"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornersImage"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp">
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/white"
                android:id="@+id/product_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:fontFamily="@font/outfit_semibold"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/white"
                android:id="@+id/grade"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:fontFamily="@font/outfit_bold"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/white"
                android:id="@+id/subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:fontFamily="@font/outfit_bold"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/green_text"
                android:id="@+id/product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:fontFamily="@font/outfit_semibold"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/delete_product_iv"
            android:padding="@dimen/_8sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete_product"
            android:layout_marginStart="@dimen/_8sdp"/>
    </LinearLayout>
</LinearLayout>
