<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="15dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/bg_image_rounded"
            android:layout_width="75dp"
            android:layout_height="75dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/imgBook"
                android:layout_width="40dp"
                android:layout_height="54dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornersImage"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#000000"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pearls of English"
                android:fontFamily="@font/outfit_medium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#777777"
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Grade 1 • English"
                android:fontFamily="@font/outfit_medium"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#000000"
            android:id="@+id/tvPrice"
            android:background="@drawable/bg_price_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500"
            android:fontFamily="@font/outfit_medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
