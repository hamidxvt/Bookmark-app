<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_inventory_0"
    android:paddingTop="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Inventory"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"/>
        <ImageView
            android:id="@+id/performanceMenu"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_three_dots"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_font"
                    android:id="@+id/inventory_search_et"
                    android:background="@drawable/edittext_background"
                    android:padding="@dimen/_8sdp"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="5dp"
                    android:hint="Search by segment, grade"
                    android:singleLine="true"
                    android:drawablePadding="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_search_visit"
                    android:fontFamily="@font/outfit"
                    android:elevation="1.5dp"
                    android:backgroundTint="@color/grey"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cancel_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:fontFamily="@font/outfit"
                    android:layout_marginStart="@dimen/_8sdp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <ImageView
                    android:tag="binding_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/filter_icon"
                    android:scaleType="centerCrop"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lowStockList_rv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/app_color"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="@dimen/_1sdp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:tag="binding_2"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="match_parent"
                        android:layout_height="132dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_low_stock"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="Low on stock"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pearls of English and 2 \10others"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="@dimen/_1sdp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:tag="binding_3"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="match_parent"
                        android:layout_height="132dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_refill_request"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="Refill Requests"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Refill Requests Track your past refill \10requests and statuses"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_total_summary_img"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Books"
                            android:fontFamily="@font/outfit_light"/>
                        <TextView
                            android:textSize="24sp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"
                            android:tag="binding_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:hint="556"
                            android:fontFamily="@font/outfit_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This week"
                            android:fontFamily="@font/outfit"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="15 Samples"
                            android:fontFamily="@font/outfit"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0.1dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/custom_button_background"
                    android:padding="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/school_type_layout"
                        android:background="@drawable/selected_button_background"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:elevation="0.3dp"
                        android:backgroundTint="#ffffff">
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textColor="@color/app_color"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/customer_type_school"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:drawablePadding="@dimen/_5sdp"
                            android:drawableStart="@drawable/ic_pin"
                            android:fontFamily="@font/outfit"
                            android:drawableTint="@color/app_color"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/shop_type_layout"
                        android:background="@drawable/unselected_button_background"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:elevation="0.3dp"
                        android:backgroundTint="#ffffff">
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/customer_type_bookshop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Books"
                            android:drawablePadding="@dimen/_5sdp"
                            android:drawableStart="@drawable/ic_books_library"
                            android:fontFamily="@font/outfit"
                            android:drawableTint="@color/grey_font"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/allBookMove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="Recommended for Today"
                android:singleLine="true"
                android:drawablePadding="15dp"
                android:drawableEnd="@drawable/all_book_move_arrow"
                android:fontFamily="@font/outfit_bold"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stock_summary_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?android:attr/progressBarStyleLarge"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:id="@+id/noDataText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Requests Found"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="Browse by Segments"
                android:fontFamily="@font/outfit_bold"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/segments_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/_2sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
