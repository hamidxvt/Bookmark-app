<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_inventory_low_stock_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_1sdp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/grey"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/productImage"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/edittext_background"
                    android:padding="@dimen/_3sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:backgroundTint="@color/app_color">
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/white"
                        android:id="@+id/stock_tv"
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="left"
                        android:layout_marginStart="@dimen/_2sdp"/>
                </LinearLayout>
            </FrameLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/addToCart"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/ic_add_inventory"
                android:contentDescription="Add to Cart"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/_5sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/productName"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="My Classroom"
                android:maxLines="2"
                android:fontFamily="@font/outfit_medium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/app_color"
                android:textColorHint="@color/app_color"
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:hint="PKR 370.00"
                android:fontFamily="@font/outfit_bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
