generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  phone        String?
  profilePhoto String?   @map("profile_photo")
  role         UserRole  @default(ADMIN)
  rememberToken String?  @map("remember_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
}

// ─── GEOGRAPHY ───────────────────────────────────────────────────────────────
model City {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  regions   Region[]
  areas     Area[]
  bookers   Booker[]
  customers Customer[]

  @@map("cities")
}

model Region {
  id        Int       @id @default(autoincrement())
  cityId    Int       @map("city_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  areas     Area[]
  bookers   Booker[]
  customers Customer[]

  @@map("regions")
}

model Area {
  id        Int       @id @default(autoincrement())
  regionId  Int       @map("region_id")
  cityId    Int       @map("city_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  city      City      @relation(fields: [cityId], references: [id])
  customers Customer[]

  @@map("areas")
}

// ─── BOOKERS (SALES REPS) ────────────────────────────────────────────────────
model Booker {
  id            Int           @id @default(autoincrement())
  name          String
  fatherName    String?       @map("father_name")
  address       String?       @db.Text
  cnic          String?       @unique @db.VarChar(20)
  gender        Gender        @default(MALE)
  dob           DateTime?     @db.Date
  cityId        Int?          @map("city_id")
  regionId      Int?          @map("region_id")
  phone         String
  email         String        @unique
  password      String
  profilePhoto  String?       @map("profile_photo")
  jobStatus     JobStatus     @default(NOT_ACTIVE) @map("job_status")
  adminApproved ApprovalStatus @default(PENDING) @map("admin_approved")
  visitTargets  Int?          @map("visit_targets")
  ratesPerVisit Decimal?      @map("rates_per_visit") @db.Decimal(10, 2)
  lastLatitude  Decimal?      @map("last_latitude") @db.Decimal(10, 8)
  lastLongitude Decimal?      @map("last_longitude") @db.Decimal(11, 8)
  lastSeenAt    DateTime?     @map("last_seen_at")
  gpsStatus     GpsStatus     @default(OFFLINE) @map("gps_status")
  fcmToken      String?       @map("fcm_token") @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  city          City?         @relation(fields: [cityId], references: [id])
  region        Region?       @relation(fields: [regionId], references: [id])
  customers     Customer[]    @relation("BookerCustomers")
  visits        Visit[]
  orders        Order[]
  gps_pings     GpsPing[]
  requests      Request[]
  messages      Message[]

  @@index([cityId])
  @@index([gpsStatus])
  @@map("bookers")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum JobStatus {
  ACTIVE
  NOT_ACTIVE

  @@map("job_status")
}

enum ApprovalStatus {
  APPROVED
  NOT_APPROVED
  PENDING

  @@map("approval_status")
}

enum GpsStatus {
  ACTIVE
  IDLE
  OFFLINE

  @@map("gps_status")
}

// ─── CUSTOMERS ───────────────────────────────────────────────────────────────
model Customer {
  id              Int            @id @default(autoincrement())
  name            String
  customerType    CustomerType   @default(OTHER) @map("customer_type")
  category        String?
  ownerName       String?        @map("owner_name")
  ownerPhone      String         @map("owner_phone")
  email           String?
  address         String?        @db.Text
  cityId          Int            @map("city_id")
  regionId        Int?           @map("region_id")
  areaId          Int?           @map("area_id")
  workingPriority Int            @default(3) @map("working_priority")
  approvalStatus  ApprovalStatus @default(NOT_APPROVED) @map("approval_status")
  assignedBookerId Int?          @map("assigned_booker_id")
  latitude        Decimal?       @db.Decimal(10, 8)
  longitude       Decimal?       @db.Decimal(11, 8)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  city            City           @relation(fields: [cityId], references: [id])
  region          Region?        @relation(fields: [regionId], references: [id])
  area            Area?          @relation(fields: [areaId], references: [id])
  assignedBooker  Booker?        @relation("BookerCustomers", fields: [assignedBookerId], references: [id])
  visits          Visit[]
  orders          Order[]

  @@index([cityId])
  @@index([approvalStatus])
  @@map("customers")
}

enum CustomerType {
  SCHOOL
  COLLEGE
  SELF
  RETAILER
  OTHER

  @@map("customer_type")
}

// ─── PRODUCTS ────────────────────────────────────────────────────────────────
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("brands")
}

model Series {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("series")
}

model Subject {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("subjects")
}

model Product {
  id          Int               @id @default(autoincrement())
  brandId     Int               @map("brand_id")
  seriesId    Int?              @map("series_id")
  subjectId   Int?              @map("subject_id")
  name        String
  isbn        String?           @unique @db.VarChar(20)
  grade       String?
  segment     String?
  description String?           @db.Text
  retailPrice Decimal           @default(0) @map("retail_price") @db.Decimal(10, 2)
  isFeatured  Boolean           @default(false) @map("is_featured")
  visibility  ProductVisibility @default(PUBLIC)
  image       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  brand       Brand             @relation(fields: [brandId], references: [id])
  series      Series?           @relation(fields: [seriesId], references: [id])
  subject     Subject?          @relation(fields: [subjectId], references: [id])
  orderItems  OrderItem[]

  @@index([brandId])
  @@index([isFeatured])
  @@map("products")
}

enum ProductVisibility {
  PUBLIC
  PRIVATE

  @@map("product_visibility")
}

// ─── VISITS ──────────────────────────────────────────────────────────────────
model Visit {
  id           Int         @id @default(autoincrement())
  bookerId     Int         @map("booker_id")
  customerId   Int         @map("customer_id")
  visitDate    DateTime    @map("visit_date") @db.Date
  checkInAt    DateTime?   @map("check_in_at")
  checkOutAt   DateTime?   @map("check_out_at")
  checkInLat   Decimal?    @map("check_in_lat") @db.Decimal(10, 8)
  checkInLng   Decimal?    @map("check_in_lng") @db.Decimal(11, 8)
  status       VisitStatus @default(PENDING)
  priority     String?
  notes        String?     @db.Text
  visitReport  String?     @map("visit_report") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  booker       Booker      @relation(fields: [bookerId], references: [id])
  customer     Customer    @relation(fields: [customerId], references: [id])
  orders       Order[]

  @@index([bookerId])
  @@index([customerId])
  @@index([visitDate])
  @@index([status])
  @@map("visits")
}

enum VisitStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("visit_status")
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────
model Order {
  id          Int         @id @default(autoincrement())
  bookerId    Int         @map("booker_id")
  customerId  Int         @map("customer_id")
  visitId     Int?        @map("visit_id")
  orderDate   DateTime    @map("order_date") @db.Date
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  booker      Booker      @relation(fields: [bookerId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  visit       Visit?      @relation(fields: [visitId], references: [id])
  items       OrderItem[]

  @@index([bookerId])
  @@index([customerId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("order_status")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int     @map("order_id")
  productId  Int     @map("product_id")
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── REQUESTS (SUPPORT TICKETS) ──────────────────────────────────────────────
model Request {
  id          Int           @id @default(autoincrement())
  bookerId    Int           @map("booker_id")
  title       String
  category    String
  details     String        @db.Text
  status      RequestStatus @default(PENDING)
  adminNotes  String?       @map("admin_notes") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booker      Booker        @relation(fields: [bookerId], references: [id])

  @@index([bookerId])
  @@map("requests")
}

enum RequestStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("request_status")
}

// ─── MESSAGES (INBOX) ────────────────────────────────────────────────────────
model Message {
  id         Int         @id @default(autoincrement())
  senderType SenderType  @map("sender_type")
  senderId   Int         @map("sender_id")
  bookerId   Int         @map("booker_id")
  message    String      @db.Text
  isRead     Boolean     @default(false) @map("is_read")
  readAt     DateTime?   @map("read_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  booker     Booker      @relation(fields: [bookerId], references: [id])

  @@index([bookerId])
  @@map("messages")
}

enum SenderType {
  ADMIN
  BOOKER

  @@map("sender_type")
}

// ─── GPS PINGS ───────────────────────────────────────────────────────────────
model GpsPing {
  id           Int      @id @default(autoincrement())
  bookerId     Int      @map("booker_id")
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  accuracy     Float?
  batteryLevel Int?     @map("battery_level") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at")

  booker       Booker   @relation(fields: [bookerId], references: [id])

  @@index([bookerId])
  @@index([createdAt])
  @@map("gps_pings")
}
